{
  "name": "kubenbody-dashboard",
  "version": "1.0.0",
  "description": "Web dashboard of KubeNBody: submit, follow, replay and compare N-body simulations",
  "scripts": {
    "dev": "next dev -p 8501",
    "build": "next build",
    "start": "next start -p 8501",
    "lint": "next lint && node scripts/check-classes.mjs",
    "type-check": "tsc --noEmit",
    "build:demo": "node scripts/build-static-demo.mjs",
    "preview:demo": "node scripts/preview-static-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "lucide-react": "^0.577.0",
    "next": "^15.0.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^14.2.0",
    "react-hook-form": "^7.48.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.160.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.160.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
