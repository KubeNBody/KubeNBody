# Local stack settings, read by docker compose from code/.env (git-ignored):
#   cp .env.example .env
# The dashboard account: user / DEFAULT_USER_PASSWORD (at least 8 characters,
# else the API creates no account and says why in `docker compose logs api`)
DEFAULT_USER_PASSWORD=change-me-please
# The key the API signs its login tokens with: any long random string, e.g. the
# output of `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-to-a-long-random-string
